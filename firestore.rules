rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && getUserData().role;
    }

    function isAuthority() {
      return isAuthenticated() && (getUserRole() == 'authority' || getUserRole() == 'official');
    }

    function isVolunteer() {
      return isAuthenticated() && getUserRole() == 'volunteer';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Users Collection
    // - Anyone authenticated can read user profiles.
    // - Users can create/update their own profile.
    // - Admins can update roles and promote users.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // Categories Collection
    // - Anyone authenticated can read categories.
    // - Only admins can create/modify categories.
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Issues Collection
    // - Anyone authenticated can read issues.
    // - Any authenticated user can create/report an issue.
    // - Any authenticated user can upvote/view/edit basic fields.
    // - Admins can delete issues.
    match /issues/{issueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Status History Subcollection
      match /statusHistory/{historyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (isAuthority() || isVolunteer() || isAdmin());
      }
    }

    // Announcements Collection
    // - Anyone authenticated can read announcements.
    // - Authorities and Admins can write announcements.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthority() || isAdmin();
    }

    // Polls Collection
    // - Anyone authenticated can read polls.
    // - Authorities and Admins can create or delete polls.
    // - Any authenticated user can vote in polls (update votes/voters).
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthority() || isAdmin();
      allow update: if isAuthenticated();
    }

    // Notifications Collection
    // - Users can read and update (mark read) their own notifications.
    // - Any authenticated user can create a notification.
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
    }

    // Audit Logs Collection
    // - Only admins can read audit logs.
    // - Authorities and Admins can create log entries.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (isAuthority() || isAdmin());
    }
  }
}
